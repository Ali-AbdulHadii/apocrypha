{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apocrypha",
  "version": "0.2.0",
  "identifier": "dev.apocrypha.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Apocrypha",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "theme": null,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Linux-first mod manager for Steam and Proton games",
    "longDescription": "Apocrypha installs and manages game mods on Linux. It finds your Steam and Proton installs, reads ZIP, 7z and RAR archives, and deploys mods through reflinks or hard links so the copy costs nothing on a filesystem that supports them. Every change to the game folder is journaled, so any deployment can be undone exactly.",
    "copyright": "Copyright (c) 2026 Apocrypha contributors",
    "publisher": "Apocrypha",
    "homepage": "https://github.com/Ali-AbdulHadii/apocrypha",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "apocrypha.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nxm"
        ]
      }
    }
  }
}
