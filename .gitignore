# Rust
/target
**/*.rs.bk

# Node
node_modules/
dist/
.vite/

# Tauri generated
apps/desktop/src-tauri/gen/schemas/

# Project-contained toolchains, installed by env.sh rather than by the machine.
# Hundreds of megabytes of compiler and runtime; the pinned versions live in
# rust-toolchain.toml and package-lock.json, which are what actually need
# committing.
.rustup/
.cargo/
.node/

# Local
*.log
.DS_Store

# Working notes kept alongside the repo but not part of it.
notes/

# docs/ holds design briefs, brand notes and correspondence drafts: useful
# locally, not something to publish. Ignored entry by entry rather than as a
# directory, because git cannot re-include a file whose parent directory is
# excluded, and one file in here does need tracking.
docs/*

# The design system is the source of truth for tokens, components and motion,
# and it says to update it in the same commit as the code it governs. That is
# not possible while it is unversioned.
!docs/design-system.md
